{% extends "_layouts/citizen.njk" %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/input/macro.njk" import govukInput %}

{% block beforeContent %}
  {{ govukBackLink({ text: back, href: backHref }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errors | length %}
        {{ govukErrorSummary({ titleText: errorSummaryTitle, errorList: errors | govukErrorSummary }) }}
      {% endif %}

      <form method="post" novalidate>
        {% include "_partials/csrf-input.njk" %}
        <span class="govuk-caption-l">{{ caption }}</span>
        <h1 class="govuk-heading-l">{{ heading }}</h1>
        <p class="govuk-body">{{ lede }}</p>

        {{ govukInput({
          id: "dxNumber",
          name: "dxNumber",
          value: values.dxNumber,
          type: "text",
          classes: "govuk-!-width-two-thirds",
          label: { text: dxNumberLabel, classes: "govuk-label--s" },
          hint: { text: dxNumberHint },
          errorMessage: { text: errors.dxNumber } if errors.dxNumber
        }) }}

        {{ govukInput({
          id: "referenceNumber",
          name: "referenceNumber",
          value: values.referenceNumber,
          type: "text",
          classes: "govuk-!-width-two-thirds",
          label: { text: referenceNumberLabel, classes: "govuk-label--s" },
          hint: { text: referenceNumberHint },
          errorMessage: { text: errors.referenceNumber } if errors.referenceNumber
        }) }}

        {{ govukButton({ text: continueText or save }) }}
      </form>
    </div>
  </div>
{% endblock %}
