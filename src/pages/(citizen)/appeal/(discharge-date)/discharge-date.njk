{% extends "_layouts/citizen.njk" %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/date-input/macro.njk" import govukDateInput %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% block beforeContent %}
  {{ govukBackLink({ text: back, href: backHref }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errors | length %}
        {{ govukErrorSummary({ titleText: errorSummaryTitle, errorList: errors | govukErrorSummary }) }}
      {% endif %}

      <form method="post" novalidate>
        {% include "_partials/csrf-input.njk" %}
        <span class="govuk-caption-l">{{ caption }}</span>

        {{ govukDateInput({
          id: "proposedDischargeDate",
          namePrefix: "proposedDischargeDate",
          fieldset: { legend: { text: proposedDischargeDateLabel, isPageHeading: true, classes: "govuk-fieldset__legend--l" } },
          hint: { text: proposedDischargeDateHint },
          items: [
            { name: "day", classes: "govuk-input--width-2", value: values["proposedDischargeDate-day"] },
            { name: "month", classes: "govuk-input--width-2", value: values["proposedDischargeDate-month"] },
            { name: "year", classes: "govuk-input--width-4", value: values["proposedDischargeDate-year"] }
          ],
          errorMessage: { text: errors.proposedDischargeDate } if errors.proposedDischargeDate
        }) }}

        {{ govukButton({ text: continueText or save }) }}
      </form>
    </div>
  </div>
{% endblock %}
