{% extends "_layouts/citizen.njk" %}
{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/character-count/macro.njk" import govukCharacterCount %}
{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% block beforeContent %}
  {{ govukBackLink({ text: back, href: backHref }) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errors | length %}
        {{ govukErrorSummary({ titleText: errorSummaryTitle, errorList: errors | govukErrorSummary }) }}
      {% endif %}

      <form method="post" novalidate>
        {% include "_partials/csrf-input.njk" %}
        <span class="govuk-caption-l">{{ caption }}</span>

        {% set appealAboutOtherHtml %}
          {{ govukCharacterCount({
            id: "appealAboutOther",
            name: "appealAboutOther",
            value: values.appealAboutOther,
            maxlength: 2000,
            rows: 4,
            label: { text: appealAboutOtherLabel },
            errorMessage: { text: errors.appealAboutOther } if errors.appealAboutOther
          }) }}
        {% endset %}

        {% set appealAboutItems = [] %}
        {% for option in appealAboutOptions %}
          {% set _ = appealAboutItems.push({
            value: option.value,
            text: option.text,
            hint: { text: option.hint } if option.hint,
            checked: option.value in values.appealAbout,
            conditional: { html: appealAboutOtherHtml } if option.value == "other"
          }) %}
        {% endfor %}
        {{ govukCheckboxes({
          name: "appealAbout",
          idPrefix: "appealAbout",
          fieldset: { legend: { text: appealAboutLabel, isPageHeading: true, classes: "govuk-fieldset__legend--l" } },
          hint: { text: appealAboutHint },
          items: appealAboutItems,
          errorMessage: { text: errors.appealAbout } if errors.appealAbout
        }) }}

        {{ govukButton({ text: continueText or save }) }}
      </form>
    </div>
  </div>
{% endblock %}
